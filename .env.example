# Required. Clients must send Authorization: Bearer <key> or x-api-key.
PROXY_API_KEY=

# DeepSeek Responses API (https://api.deepseek.com/responses).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# GitHub: resolve tag/SHA, version.php, ancestor checks.
GITHUB_TOKEN=

# Optional durable CVE parse cache (Upstash Redis REST). Memory is always used first.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override.
SECURITYCONTEXT_MCP_URL=https://securitycontext.dev/mcp
SECURITYCONTEXT_JSON_BASE=https://securitycontext.dev/r
